<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ report.portfolio_name }} – IEQ report</title>
<style>
  :root {
    --bg: #f6f7f9; --surface: #ffffff; --text: #111827; --muted: #5b6472; --border: #e3e6ea;
    --accent: #1d4ed8; --cat-1: #15803d; --cat-2: #65a30d; --cat-3: #d97706; --cat-4: #dc2626; --cat-none: #9ca3af;
    --lvl-1-bg: #dcfce7; --lvl-2-bg: #ecfccb; --lvl-3-bg: #fef3c7; --lvl-4-bg: #fee2e2; --meter-bg: #e5e7eb;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1115; --surface: #171a21; --text: #e8eaed; --muted: #9aa3ae; --border: #2a2f39;
      --accent: #7aa2ff; --lvl-1-bg: #12351f; --lvl-2-bg: #263512; --lvl-3-bg: #3d2c0a; --lvl-4-bg: #401616; --meter-bg: #2a2f39;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1180px; margin: 0 auto; padding: 32px 16px 64px; }
  h1 { font-size: 28px; margin: 0 0 4px; letter-spacing: -0.01em; }
  h2 { font-size: 19px; margin: 40px 0 12px; }
  h3 { font-size: 15px; margin: 0 0 6px; }
  .muted { color: var(--muted); }
  .small { font-size: 12.5px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px 18px; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin-top: 20px; }
  .kpi .value { font-size: 26px; font-weight: 650; font-variant-numeric: tabular-nums; }
  .kpi .label { color: var(--muted); font-size: 12.5px; }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px; }
  ul.findings { margin: 0; padding-left: 18px; } ul.findings li { margin: 4px 0; }
  .scroll { overflow-x: auto; }
  .grid2 > *, .kpis > * { min-width: 0; }
  .table-wrap { overflow-x: auto; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  th, td { padding: 8px 10px; text-align: left; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); font-weight: 600; white-space: nowrap; }
  th[data-sort] { cursor: pointer; user-select: none; } th[data-sort]:hover { color: var(--text); }
  td.num, th.num { text-align: right; }
  tr:last-child td { border-bottom: 0; }
  .cat { display: inline-block; min-width: 34px; text-align: center; padding: 1px 8px; border-radius: 999px; font-weight: 600; font-size: 12px; color: #fff; }
  .cat-I { background: var(--cat-1); } .cat-II { background: var(--cat-2); } .cat-III { background: var(--cat-3); } .cat-IV { background: var(--cat-4); } .cat-none { background: var(--cat-none); }
  .lvl-1 { background: var(--lvl-1-bg); } .lvl-2 { background: var(--lvl-2-bg); } .lvl-3 { background: var(--lvl-3-bg); } .lvl-4 { background: var(--lvl-4-bg); }
  .pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 12px; border: 1px solid var(--border); }
  .prio-high { color: var(--cat-4); font-weight: 600; } .prio-medium { color: var(--cat-3); font-weight: 600; } .prio-low { color: var(--cat-1); font-weight: 600; }
  .legend { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; font-size: 12.5px; color: var(--muted); }
  .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 5px; vertical-align: -1px; }
  svg.chart { display: block; width: 100%; height: auto; }
  svg.stacked { height: 22px; border-radius: 5px; overflow: hidden; }
  svg.meter { width: 90px; height: 8px; display: inline-block; vertical-align: middle; margin-left: 6px; }
  .meter-bg { fill: var(--meter-bg); }
  .bar-label { font-size: 11px; fill: #fff; font-weight: 600; }
  .tick { font-size: 10.5px; fill: var(--muted); } .axis { stroke: var(--border); }
  .room-card { margin-bottom: 12px; }
  .room-card header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; align-items: baseline; }
  .room-card .issues { margin: 8px 0; padding-left: 18px; }
  details > summary { cursor: pointer; color: var(--accent); margin: 6px 0; }
  .rec { border-left: 3px solid var(--accent); padding: 6px 10px; margin: 8px 0; background: var(--bg); border-radius: 4px; }
  .filter { width: 100%; max-width: 320px; padding: 7px 10px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); color: var(--text); margin-bottom: 10px; }
  footer { margin-top: 48px; color: var(--muted); font-size: 12px; }
  @media print {
    body { background: #fff; } .filter, details > summary { display: none; }
    .card, .table-wrap { break-inside: avoid; }
    h2 { break-after: avoid; }
  }
</style>
</head>
<body>
<main>
<header>
  <div class="muted small">Indoor environmental quality report</div>
  <h1>{{ report.portfolio_name }}</h1>
  <div class="muted">
    {{ cfg.seasons | length > 1 and "Full year (" ~ (cfg.seasons | map("capitalize") | join(" + ")) ~ ")" or (cfg.seasons[0] | replace("_", " ") | capitalize) }}
    · Target: EN 16798-1 Category {{ cfg.target_category }}
    · Generated {{ report.generated_at | date }}
  </div>
</header>

<section class="kpis" aria-label="Key figures">
  <div class="card kpi"><div class="value">{{ s.ieq_score | num }}</div><div class="label">IEQ score (0–100)</div></div>
  <div class="card kpi"><div class="value">{{ s.meets_target_pct | pct(0) }}</div><div class="label">Rooms meeting Category {{ cfg.target_category }}</div></div>
  <div class="card kpi"><div class="value">{% if s.category %}<span class="cat cat-{{ s.category }}">{{ s.category }}</span>{% else %}–{% endif %}</div><div class="label">Portfolio category ({{ (cfg.group_category_threshold * 100) | round | int }}% rule)</div></div>
  <div class="card kpi"><div class="value">{{ s.rooms_analysed }}<span class="muted" style="font-size:16px"> / {{ s.rooms_total }}</span></div><div class="label">Rooms analysed ({{ s.coverage_pct | pct(0) }} coverage)</div></div>
  <div class="card kpi"><div class="value">{{ report.buildings | length }}</div><div class="label">Buildings</div></div>
</section>

{% if report.highlights %}
<h2>Key findings</h2>
<div class="card"><ul class="findings">{% for h in report.highlights %}<li>{{ h }}</li>{% endfor %}</ul></div>
{% endif %}

<h2>Portfolio overview</h2>
<div class="grid2">
  <div class="card">
    <h3>Rooms by achieved category</h3>
    {{ category_bar(s.category_counts) }}
    <div class="legend">
      {% for c in ["I", "II", "III", "IV", "none"] %}
      <span><i class="cat-{{ c }}"></i>{{ CATEGORY_LABELS[c] }}: {{ s.category_counts[c] }}</span>
      {% endfor %}
    </div>
    <h3 style="margin-top:16px">Time within Category {{ cfg.target_category }} limits</h3>
    <table class="small">
      {% for p, v in s.compliance.items() %}
      <tr><td>{{ param_label(p) }}</td><td class="num">{{ v | pct }} {{ meter(v) }}</td></tr>
      {% else %}
      <tr><td class="muted">No parameter data.</td></tr>
      {% endfor %}
    </table>
  </div>
  <div class="card">
    <h3>Distribution of room IEQ scores</h3>
    {{ histogram(s.score_histogram) }}
    <p class="muted small">Each bar counts rooms by composite score (0 = never within limits, 100 = always).</p>
  </div>
</div>

{% if report.actions %}
<h2>Priority actions</h2>
<div class="table-wrap">
<table>
  <thead><tr><th>Priority</th><th>Action</th><th class="num">Rooms</th><th>Where</th><th>Expected benefit (worst case)</th></tr></thead>
  <tbody>
  {% for a in report.actions %}
    <tr>
      <td class="prio-{{ a.priority }}">{{ a.priority | capitalize }}</td>
      <td><strong>{{ a.title }}</strong>{% if a.description %}<div class="muted small">{{ a.description }}</div>{% endif %}</td>
      <td class="num">{{ a.room_ids | length }}</td>
      <td class="small">{{ a.room_names[:6] | join(", ") }}{% if a.room_names | length > 6 %} and {{ a.room_names | length - 6 }} more{% endif %}</td>
      <td class="small">{{ a.expected_benefit or "–" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endif %}

<h2>Buildings</h2>
<div class="table-wrap">
<table class="sortable">
  <thead><tr>
    <th data-sort="text">Building</th><th data-sort="num" class="num">Rooms</th><th data-sort="text">Category</th>
    <th data-sort="num" class="num">Meets target</th><th data-sort="num" class="num">Score</th>
    <th data-sort="num" class="num">Temp.</th><th data-sort="num" class="num">CO₂</th><th data-sort="num" class="num">RH</th>
    <th style="min-width:160px">Category mix</th>
  </tr></thead>
  <tbody>
  {% for b in report.buildings %}
    <tr>
      <td><strong>{{ b.building_name }}</strong><div class="muted small">{{ [b.building_type, b.city] | select | join(" · ") }}</div></td>
      <td class="num" data-v="{{ b.summary.rooms_analysed }}">{{ b.summary.rooms_analysed }}/{{ b.summary.rooms_total }}</td>
      <td data-v="{{ b.summary.category or 'Z' }}">{% if b.summary.category %}<span class="cat cat-{{ b.summary.category }}">{{ b.summary.category }}</span>{% else %}–{% endif %}</td>
      <td class="num" data-v="{{ b.summary.meets_target_pct if b.summary.meets_target_pct is not none else -1 }}">{{ b.summary.meets_target_pct | pct(0) }}</td>
      <td class="num {{ b.summary.ieq_score | level }}" data-v="{{ b.summary.ieq_score if b.summary.ieq_score is not none else -1 }}">{{ b.summary.ieq_score | num }}</td>
      {% for p in ["temperature", "co2", "humidity"] %}
      {% set v = b.summary.compliance.get(p) %}
      <td class="num {{ v | level }}" data-v="{{ v if v is not none else -1 }}">{{ v | pct }}</td>
      {% endfor %}
      <td>{{ category_bar(b.summary.category_counts, width=200, height=14) }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>

{% set worst = report.worst_rooms %}
{% if worst %}
<h2>Rooms needing attention</h2>
<p class="muted">The {{ worst | length }} room(s) furthest from the Category {{ cfg.target_category }} target, worst first.</p>
{% for r in worst %}
<article class="card room-card">
  <header>
    <div>
      <h3>{{ r.room_name }}</h3>
      <div class="muted small">{{ [r.building_name, r.floor_name, r.room_type] | select | join(" · ") }}{% if r.area_m2 %} · {{ r.area_m2 | num(0, "m²") }}{% endif %}</div>
    </div>
    <div>
      {% if r.achieved_category %}<span class="cat cat-{{ r.achieved_category }}">{{ r.achieved_category }}</span>{% else %}<span class="cat cat-none">n/a</span>{% endif %}
      <span class="pill {{ r.ieq_score | level }}">Score {{ r.ieq_score | num }}</span>
      {% if r.tail_rating %}<span class="pill">TAIL {{ r.tail_rating }}</span>{% endif %}
      {% if r.br18_pass is not none %}<span class="pill">BR18 {{ "pass" if r.br18_pass else "fail" }}</span>{% endif %}
    </div>
  </header>
  {% if r.issues %}<ul class="issues">{% for i in r.issues %}<li>{{ i }}</li>{% endfor %}</ul>{% endif %}
  {% if r.parameters %}
  <div class="scroll">
  <table class="small">
    <thead><tr><th>Parameter</th><th class="num">Within Cat {{ cfg.target_category }}</th><th class="num">Mean</th><th class="num">Min</th><th class="num">Max</th></tr></thead>
    <tbody>
    {% for p, ps in r.parameters.items() %}
      <tr><td>{{ param_label(p) }}</td><td class="num {{ ps.compliance_pct | level }}">{{ ps.compliance_pct | pct }}</td>
      <td class="num">{{ ps.mean | num(1, ps.unit or "") }}</td><td class="num">{{ ps.minimum | num(1) }}</td><td class="num">{{ ps.maximum | num(1) }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
  {% if r.seasons | length > 1 %}
  <p class="small muted">By season:
    {% for se in r.seasons %}{{ se.season | capitalize }} {{ se.achieved_category or "n/a" }} ({{ se.compliance_pct | pct(0) }} within target){% if not loop.last %} · {% endif %}{% endfor %}
  </p>
  {% endif %}
  {% if r.ventilation %}<p class="small"><strong>Ventilation:</strong> {{ r.ventilation.description }}</p>{% endif %}
  {% if r.recommendations %}
  <details>
    <summary>{{ r.recommendations | length }} recommendation(s)</summary>
    {% for rec in r.recommendations %}
    <div class="rec">
      <strong>{{ rec.title }}</strong> <span class="small prio-{{ rec.priority }}">{{ rec.priority | capitalize }}</span>
      <div class="small">{{ rec.description }}</div>
      {% if rec.expected_benefit %}<div class="small muted">Benefit: {{ rec.expected_benefit }}</div>{% endif %}
    </div>
    {% endfor %}
  </details>
  {% endif %}
  <div class="small muted">
    Data: {{ r.data_quality.get("samples", 0) }} samples, {{ r.data_quality.get("start") | date }} → {{ r.data_quality.get("end") | date }},
    {{ r.data_quality.get("completeness_pct") | pct(0) }} complete{% if r.data_quality.get("gaps") %}, {{ r.data_quality.get("gaps") }} gap(s){% endif %}.
    {% if r.warnings %}<br>Notes: {{ r.warnings | join(" ") }}{% endif %}
  </div>
</article>
{% endfor %}
{% endif %}

<h2>All rooms</h2>
<details {% if report.rooms | length <= 60 %}open{% endif %}>
<summary>Show all {{ report.rooms | length }} rooms</summary>
<input class="filter" type="search" placeholder="Filter rooms, buildings, categories…" aria-label="Filter rooms" data-filter="rooms-table">
<div class="table-wrap">
<table class="sortable" id="rooms-table">
  <thead><tr>
    <th data-sort="text">Building</th><th data-sort="text">Floor</th><th data-sort="text">Room</th>
    <th data-sort="text">Category</th><th data-sort="num" class="num">Score</th>
    <th data-sort="num" class="num">Temp.</th><th data-sort="num" class="num">CO₂</th><th data-sort="num" class="num">RH</th>
    <th data-sort="text">TAIL</th><th data-sort="num" class="num">Data</th>
  </tr></thead>
  <tbody>
  {% for r in report.rooms %}
    <tr>
      <td>{{ r.building_name or "–" }}</td><td>{{ r.floor_name or "–" }}</td>
      <td>{{ r.room_name }}{% if r.status != "ok" %} <span class="pill">{{ "no data" if r.status == "no_data" else "error" }}</span>{% endif %}</td>
      <td data-v="{{ r.achieved_category or 'Z' }}">{% if r.achieved_category %}<span class="cat cat-{{ r.achieved_category }}">{{ r.achieved_category }}</span>{% else %}–{% endif %}</td>
      <td class="num {{ r.ieq_score | level }}" data-v="{{ r.ieq_score if r.ieq_score is not none else -1 }}">{{ r.ieq_score | num }}</td>
      {% for p in ["temperature", "co2", "humidity"] %}
      {% set v = r.compliance.get(p) %}
      <td class="num {{ v | level }}" data-v="{{ v if v is not none else -1 }}">{{ v | pct }}</td>
      {% endfor %}
      <td>{{ r.tail_rating or "–" }}</td>
      {% set c = r.data_quality.get("completeness_pct") %}
      <td class="num" data-v="{{ c if c is not none else -1 }}">{{ c | pct(0) }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
</details>

{% set problem_rooms = report.rooms | selectattr("status", "ne", "ok") | list %}
{% if problem_rooms or report.warnings %}
<h2>Data coverage</h2>
<div class="card">
  {% if problem_rooms %}
  <p>{{ problem_rooms | length }} room(s) were not assessed:</p>
  <ul class="small">
    {% for r in problem_rooms[:200] %}<li>{{ r.building_name or "–" }} / {{ r.room_name }}: {{ r.message }}</li>{% endfor %}
    {% if problem_rooms | length > 200 %}<li>… and {{ problem_rooms | length - 200 }} more (see JSON/CSV export).</li>{% endif %}
  </ul>
  {% endif %}
</div>
{% endif %}

<h2>Method</h2>
<div class="card small">
  <ul class="findings">
    <li><strong>Standard.</strong> Rooms are assessed with EN 16798-1 (plus TAIL and BR18 where applicable). The achieved category is the best category whose limits are met for the share of time the standard requires.</li>
    <li><strong>Seasons.</strong> {% if cfg.seasons | length > 1 %}Data is split into the country's heating and cooling months; each part is assessed with its own criteria, and a room's category is its worst seasonal category.{% else %}All data is assessed with {{ cfg.seasons[0] }} criteria.{% endif %}</li>
    <li><strong>Compliance %.</strong> Share of samples within Category {{ cfg.target_category }} limits, per parameter. Parameters below {{ cfg.issue_threshold_pct | num(0) }}% are listed as issues.</li>
    <li><strong>IEQ score.</strong> Weighted mean of parameter compliance ({% for p, w in cfg.score_weights.items() %}{{ param_label(p) }} {{ (w * 100) | round | int }}%{% if not loop.last %}, {% endif %}{% endfor %}; weights renormalised over available parameters).</li>
    <li><strong>Building and portfolio category.</strong> The best category that at least {{ (cfg.group_category_threshold * 100) | round | int }}% of rated rooms reach. Building and portfolio averages are area-weighted when every room has a floor area.</li>
    <li><strong>Identifiers.</strong> Brick classes and IFC GlobalIds for every room are in the JSON and CSV exports.</li>
  </ul>
</div>

<footer>
  {{ report.schema_version }} · {{ report.rooms | length }} rooms · built in {{ report.duration_s | num(1) }} s
</footer>
</main>
<script>
(function () {
  document.querySelectorAll("table.sortable").forEach(function (table) {
    table.querySelectorAll("th[data-sort]").forEach(function (th, col) {
      th.addEventListener("click", function () {
        var body = table.tBodies[0], rows = Array.prototype.slice.call(body.rows);
        var numeric = th.dataset.sort === "num", dir = th.dataset.dir === "asc" ? -1 : 1;
        th.dataset.dir = dir === 1 ? "asc" : "desc";
        var idx = Array.prototype.indexOf.call(th.parentNode.children, th);
        rows.sort(function (a, b) {
          var x = a.cells[idx], y = b.cells[idx];
          var vx = x.dataset.v !== undefined ? x.dataset.v : x.textContent.trim();
          var vy = y.dataset.v !== undefined ? y.dataset.v : y.textContent.trim();
          return numeric ? dir * (parseFloat(vx) - parseFloat(vy)) : dir * vx.localeCompare(vy);
        });
        rows.forEach(function (r) { body.appendChild(r); });
      });
    });
  });
  document.querySelectorAll("input[data-filter]").forEach(function (input) {
    var table = document.getElementById(input.dataset.filter);
    input.addEventListener("input", function () {
      var q = input.value.toLowerCase();
      Array.prototype.forEach.call(table.tBodies[0].rows, function (row) {
        row.style.display = row.textContent.toLowerCase().indexOf(q) === -1 ? "none" : "";
      });
    });
  });
})();
</script>
</body>
</html>
