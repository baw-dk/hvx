<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ report.portfolio_name }} – {{ _("IEQ report") }}</title>
<style>
  :root {
    --bg: #f6f7f9; --surface: #ffffff; --text: #111827; --muted: #5b6472; --border: #e3e6ea;
    --accent: #1d4ed8; --cat-1: #15803d; --cat-2: #65a30d; --cat-3: #d97706; --cat-4: #dc2626; --cat-none: #9ca3af;
    --lvl-1-bg: #dcfce7; --lvl-2-bg: #ecfccb; --lvl-3-bg: #fef3c7; --lvl-4-bg: #fee2e2; --meter-bg: #e5e7eb;
  }
  {% if brand and brand.accent %}:root { --accent: {{ brand.accent }}; --brand: {{ brand.accent }}; }{% endif %}
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1115; --surface: #171a21; --text: #e8eaed; --muted: #9aa3ae; --border: #2a2f39;
      --accent: #7aa2ff; --lvl-1-bg: #12351f; --lvl-2-bg: #263512; --lvl-3-bg: #3d2c0a; --lvl-4-bg: #401616; --meter-bg: #2a2f39;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1180px; margin: 0 auto; padding: 32px 16px 64px; }
  h1 { font-size: 28px; margin: 0 0 4px; letter-spacing: -0.01em; }
  h2 { font-size: 19px; margin: 40px 0 12px; }
  h3 { font-size: 15px; margin: 0 0 6px; }
  .muted { color: var(--muted); }
  {% if brand %}
  .report-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .brand-logo { max-height: 44px; max-width: 180px; object-fit: contain; }
  .brand-wordmark { font-weight: 750; font-size: 20px; letter-spacing: .02em; color: var(--brand, var(--accent)); white-space: nowrap; }
  .brand-bar { height: 4px; border-radius: 2px; background: var(--brand, var(--accent)); margin-bottom: 18px; }
  .imprint { margin-top: 40px; padding-top: 12px; border-top: 1px solid var(--border); font-size: 12px; color: var(--muted); }
  .imprint strong { color: var(--text); }
  {% endif %}
  .small { font-size: 12.5px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px 18px; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin-top: 20px; }
  .kpi .value { font-size: 26px; font-weight: 650; font-variant-numeric: tabular-nums; }
  .kpi .label { color: var(--muted); font-size: 12.5px; }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px; }
  ul.findings { margin: 0; padding-left: 18px; } ul.findings li { margin: 4px 0; }
  .scroll { overflow-x: auto; }
  .grid2 > *, .kpis > * { min-width: 0; }
  .table-wrap { overflow-x: auto; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  th, td { padding: 8px 10px; text-align: left; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); font-weight: 600; white-space: nowrap; }
  th[data-sort] { cursor: pointer; user-select: none; } th[data-sort]:hover { color: var(--text); }
  td.num, th.num { text-align: right; }
  tr:last-child td { border-bottom: 0; }
  .cat { display: inline-block; min-width: 34px; text-align: center; padding: 1px 8px; border-radius: 999px; font-weight: 600; font-size: 12px; color: #fff; }
  .cat-I { background: var(--cat-1); } .cat-II { background: var(--cat-2); } .cat-III { background: var(--cat-3); } .cat-IV { background: var(--cat-4); } .cat-none { background: var(--cat-none); }
  .lvl-1 { background: var(--lvl-1-bg); } .lvl-2 { background: var(--lvl-2-bg); } .lvl-3 { background: var(--lvl-3-bg); } .lvl-4 { background: var(--lvl-4-bg); }
  .pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 12px; border: 1px solid var(--border); }
  .prio-high { color: var(--cat-4); font-weight: 600; } .prio-medium { color: var(--cat-3); font-weight: 600; } .prio-low { color: var(--cat-1); font-weight: 600; }
  .legend { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; font-size: 12.5px; color: var(--muted); }
  .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 5px; vertical-align: -1px; }
  svg.chart { display: block; width: 100%; height: auto; }
  svg.stacked { height: 22px; border-radius: 5px; overflow: hidden; }
  svg.meter { width: 90px; height: 8px; display: inline-block; vertical-align: middle; margin-left: 6px; }
  .meter-bg { fill: var(--meter-bg); }
  .bar-label { font-size: 11px; fill: #fff; font-weight: 600; }
  .tick { font-size: 10.5px; fill: var(--muted); } .axis { stroke: var(--border); }
  .room-card { margin-bottom: 12px; }
  .room-card header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; align-items: baseline; }
  .room-card .issues { margin: 8px 0; padding-left: 18px; }
  details > summary { cursor: pointer; color: var(--accent); margin: 6px 0; }
  .rec { border-left: 3px solid var(--accent); padding: 6px 10px; margin: 8px 0; background: var(--bg); border-radius: 4px; }
  .filter { width: 100%; max-width: 320px; padding: 7px 10px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); color: var(--text); margin-bottom: 10px; }
  footer { margin-top: 48px; color: var(--muted); font-size: 12px; }
  .intro p { margin: 0 0 10px; max-width: 75ch; }
  svg.tail { display: block; max-width: 100%; height: auto; }
  .tail-tree-fig { margin: 0 0 6px; }
  .tail-tree-fig figcaption { font-size: 12.5px; color: var(--muted); margin-bottom: 8px; }
  .tail-badge { display: inline-block; min-width: 30px; text-align: center; padding: 1px 8px; border-radius: 999px; font-weight: 650; font-size: 12px; white-space: nowrap; }
  table.tail-matrix { margin-top: 14px; }
  table.tail-matrix td.c, table.tail-matrix th.c { text-align: center; }
  .tail-spread { display: flex; width: 74px; height: 5px; margin: 5px auto 0; border-radius: 3px; overflow: hidden; gap: 1px; background: var(--surface); }
  .tail-spread i { display: block; height: 100%; }
  table.tail-matrix tr.total td { font-weight: 650; border-bottom: 2px solid var(--border); }
  .room-tail { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 8px 0 4px; font-size: 12.5px; color: var(--muted); }
  .heat { border-collapse: separate; border-spacing: 2px; font-size: 11.5px; }
  .heat th { text-transform: none; letter-spacing: 0; text-align: center; padding: 2px 4px; font-size: 11px; }
  .heat th.rowh { text-align: left; white-space: nowrap; font-weight: 500; color: var(--text); }
  .heat td { text-align: center; padding: 5px 4px; border-radius: 3px; border: 0; min-width: 34px; }
  .heat tr.group th.rowh { font-weight: 700; }
  .heat-0 { background: var(--lvl-1-bg); } .heat-1 { background: var(--lvl-2-bg); } .heat-2 { background: var(--lvl-3-bg); } .heat-3 { background: var(--lvl-4-bg); }
  .heat-na { background: transparent; color: var(--muted); }
  .heat-legend { display: flex; gap: 10px; flex-wrap: wrap; font-size: 12px; color: var(--muted); margin-top: 6px; }
  .heat-legend span::before { content: ""; display: inline-block; width: 12px; height: 12px; border-radius: 2px; margin-right: 4px; vertical-align: -2px; background: var(--c); }
  @page { size: A4; margin: 14mm 12mm 16mm; }
  @media print {
    :root { --bg: #fff; --surface: #fff; --text: #111827; --muted: #4b5563; --border: #d9dde3;
            --lvl-1-bg: #dcfce7; --lvl-2-bg: #ecfccb; --lvl-3-bg: #fef3c7; --lvl-4-bg: #fee2e2; --meter-bg: #e5e7eb; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    body { background: #fff; font-size: 10.5px; }
    main { max-width: none; padding: 0; }
    h1 { font-size: 22px; } h2 { font-size: 15px; margin: 22px 0 8px; break-after: avoid; } h3 { font-size: 12.5px; }
    .filter, details > summary, footer { display: none; }
    .card, .kpi, tr, .heat { break-inside: avoid; }
    /* Room cards may run across pages; keep their blocks whole instead. */
    .card.room-card { break-inside: auto; }
    .room-card header, .room-card .issues, .room-card .scroll, .rec { break-inside: avoid; }
    .heat td { padding: 3px 4px; }
    td.where { min-width: 190px; }
    .table-wrap { overflow: visible; }
    .kpis { grid-template-columns: repeat(5, 1fr); }
    .grid2 { grid-template-columns: 1fr 1fr; }
    .page-break { break-before: page; }
    th, td { padding: 5px 6px; }
  }
</style>
</head>
<body>
<main>
<header>
  {% if brand %}<div class="brand-bar"></div>{% endif %}
  <div class="report-head"><div>
  <div class="muted small">{{ _("Indoor environmental quality report") }}</div>
  <h1>{{ report.portfolio_name }}</h1>
  <div class="muted">
    {% if cfg.seasons | length > 1 %}{{ _("Full year ({seasons})", seasons=(cfg.seasons | map("translate") | map("capitalize") | join(" + "))) }}{% else %}{{ _(cfg.seasons[0]) | capitalize }}{% endif %}
    · {{ _("Target: EN 16798-1 Category {cat}", cat=cfg.target_category) }}
    {% set occ = (report.rooms | selectattr("occupancy") | map(attribute="occupancy") | unique | list) %}
    {% if occ | length == 1 %}· {{ _("Assessed: {hours}", hours=occ[0]) }}{% endif %}
    · {{ _("Generated {date}", date=(report.generated_at | date)) }}
  </div>
  </div>
  {% if brand %}
  <div class="brand">{% if brand.logo %}<img class="brand-logo" src="{{ brand.logo }}" alt="{{ brand.legal_name or brand.name }}">{% else %}<span class="brand-wordmark">{{ brand.name }}</span>{% endif %}</div>
  {% endif %}
  </div>
</header>

{% if cfg.introduction %}
<section class="intro" style="margin-top:18px">
  {% for para in cfg.introduction.split("\n\n") %}<p>{{ para }}</p>{% endfor %}
</section>
{% endif %}

<section class="kpis" aria-label="{{ _('Key figures') }}">
  <div class="card kpi"><div class="value">{{ s.ieq_score | num }}</div><div class="label">{{ _("IEQ score (0–100)") }}</div></div>
  <div class="card kpi"><div class="value">{{ s.meets_target_pct | pct(0) }}</div><div class="label">{{ _("Rooms meeting Category {cat}", cat=cfg.target_category) }}</div></div>
  <div class="card kpi"><div class="value">{% if s.category %}<span class="cat cat-{{ s.category }}">{{ s.category }}</span>{% else %}<span class="cat cat-none">–</span>{% endif %}</div><div class="label">{{ _("Portfolio category ({pct}% rule)", pct=((cfg.group_category_threshold * 100) | round | int)) }}</div></div>
  <div class="card kpi"><div class="value">{{ s.rooms_analysed }}<span class="muted" style="font-size:16px"> / {{ s.rooms_total }}</span></div><div class="label">{{ _("Rooms analysed ({pct} coverage)", pct=(s.coverage_pct | pct(0))) }}</div></div>
  <div class="card kpi"><div class="value">{{ report.buildings | length }}</div><div class="label">{{ _("Buildings") }}</div></div>
</section>

{% if report.highlights %}
<h2>{{ _("Key findings") }}</h2>
<div class="card"><ul class="findings">{% for h in report.highlights %}<li>{{ h }}</li>{% endfor %}</ul></div>
{% endif %}

<h2>{{ _("Portfolio overview") }}</h2>
<div class="grid2">
  <div class="card">
    <h3>{{ _("Rooms by achieved category") }}</h3>
    {{ category_bar(s.category_counts) }}
    <div class="legend">
      {% for c in ["I", "II", "III", "IV", "none"] %}
      <span><i class="cat-{{ c }}"></i>{{ category_label(c) }}: {{ s.category_counts[c] }}</span>
      {% endfor %}
    </div>
    {% if s.exceedance_hours %}
    <h3 style="margin-top:16px">{{ _("Average hours per room above limits (occupied time)") }}</h3>
    <table class="small">
      {% for key, hours in s.exceedance_hours.items() %}
      {% set p, lim = key.split(">") %}
      <tr><td>{{ param_label(p) }} &gt; {{ lim }} {{ "ppm" if p == "co2" else "°C" }}</td><td class="num">{{ hours | num(0, unit_h) }}</td></tr>
      {% endfor %}
    </table>
    {% endif %}
    <h3 style="margin-top:16px">{{ _("Time within Category {cat} limits", cat=cfg.target_category) }}</h3>
    <table class="small">
      {% for p, v in s.compliance.items() %}
      <tr><td>{{ param_label(p) }}</td><td class="num">{{ v | pct }} {{ meter(v) }}</td></tr>
      {% else %}
      <tr><td class="muted">{{ _("No parameter data.") }}</td></tr>
      {% endfor %}
    </table>
  </div>
  <div class="card">
    <h3>{{ _("Distribution of room IEQ scores") }}</h3>
    {{ histogram(s.score_histogram) }}
    <p class="muted small">{{ _("Each bar counts rooms by composite score (0 = never within limits, 100 = always).") }}</p>
  </div>
</div>

{% if s.tail %}
<h2>{{ _("TAIL rating") }}</h2>
<div class="card">
  <figure class="tail-tree-fig">
    <figcaption><strong>{{ _("Typical room (hvx summary)") }}</strong> · {{ report.portfolio_name }} · {{ _("{n} rooms", n=s.tail.get("rooms", 0)) }}</figcaption>
    {{ tail_tree(s.tail) }}
  </figure>
  {% set tail_buildings = report.buildings | selectattr("summary.tail") | list %}
  {% if tail_buildings | length > 1 %}
  <p class="muted small" style="margin:14px 0 0">{{ _("Badges: the typical room (hvx summary: rounded mean of the rooms' TAIL ratings, not a TAIL building rating). Bars below: how the rooms are spread over I–IV.") }}</p>
  <div class="scroll">
  <table class="tail-matrix">
    <thead><tr><th>{{ _("Building") }}</th><th class="num">{{ _("Rooms") }}</th><th class="c">{{ _("Overall") }}</th>
      {% for key, name in tail_domains %}<th class="c">{{ name }}</th>{% endfor %}</tr></thead>
    <tbody>
      <tr class="total"><td>{{ report.portfolio_name }}</td><td class="num">{{ s.tail.get("rooms", 0) }}</td><td class="c">{{ tail_badge(s.tail.overall) }}{{ tail_spread((s.tail.distribution or {}).get("overall")) }}</td>
        {% for key, name in tail_domains %}<td class="c">{{ tail_badge((s.tail.domains or {}).get(key)) }}{{ tail_spread((s.tail.distribution or {}).get(key)) }}</td>{% endfor %}</tr>
      {% for b in tail_buildings %}
      <tr><td>{{ b.building_name }}</td><td class="num">{{ b.summary.tail.get("rooms", 0) }}</td><td class="c">{{ tail_badge(b.summary.tail.overall) }}{{ tail_spread((b.summary.tail.distribution or {}).get("overall")) }}</td>
        {% for key, name in tail_domains %}<td class="c">{{ tail_badge((b.summary.tail.domains or {}).get(key)) }}{{ tail_spread((b.summary.tail.distribution or {}).get(key)) }}</td>{% endfor %}</tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
  <p class="muted small" style="margin-top:12px">{{ _("TAIL rates Thermal, Acoustic, Indoor air and Luminous conditions from I (best) to IV. Read the tree from left to right: each domain takes its worst parameter and the overall rating its worst domain. For a group of rooms the tree shows the typical room, an hvx summary: each parameter is the rounded mean of the rooms' TAIL ratings. It is not a TAIL building rating, which TAIL derives from the pooled data of all rooms. Grey, dashed: not measured, so the domain is not rated.") }}</p>
</div>
{% endif %}

{% if report.actions %}
<h2>{{ _("Priority actions") }}</h2>
<div class="table-wrap">
<table>
  <thead><tr><th>{{ _("Priority") }}</th><th>{{ _("Action") }}</th><th class="num">{{ _("Rooms") }}</th><th>{{ _("Where") }}</th><th>{{ _("Expected effect (range over the rooms)") }}</th></tr></thead>
  <tbody>
  {% for a in report.actions %}
    <tr>
      <td class="prio-{{ a.priority }}">{{ _(a.priority | capitalize) }}</td>
      <td><strong>{{ a.title }}</strong>{% if a.description %}<div class="muted small">{{ a.description }}</div>{% endif %}</td>
      <td class="num">{{ a.room_ids | length }}</td>
      <td class="small where">{{ a.room_names[:6] | join(", ") }}{% if a.room_names | length > 6 %} {{ _("and {n} more", n=(a.room_names | length - 6)) }}{% endif %}</td>
      <td class="small">{{ a.expected_benefit or "–" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endif %}

<h2>{{ _("Buildings") }}</h2>
<div class="table-wrap">
<table class="sortable">
  <thead><tr>
    <th data-sort="text">{{ _("Building") }}</th><th data-sort="num" class="num">{{ _("Rooms") }}</th><th data-sort="text">{{ _("Category") }}</th>
    <th data-sort="num" class="num">{{ _("Meets target") }}</th><th data-sort="num" class="num">{{ _("Score") }}</th>
    <th data-sort="num" class="num">{{ _("Temp.") }}</th><th data-sort="num" class="num">CO₂</th><th data-sort="num" class="num">{{ _("RH") }}</th>
    <th data-sort="num" class="num" title="{{ _('Average hours per room above 1000 ppm during occupied time') }}">CO₂&gt;1000 {{ unit_h }}</th>
    <th style="min-width:160px">{{ _("Category mix") }}</th>
  </tr></thead>
  <tbody>
  {% for b in report.buildings %}
    <tr>
      <td><strong>{{ b.building_name }}</strong><div class="muted small">{{ [b.building_type and _(b.building_type), b.city] | select | join(" · ") }}</div></td>
      <td class="num" data-v="{{ b.summary.rooms_analysed }}">{{ b.summary.rooms_analysed }}/{{ b.summary.rooms_total }}</td>
      <td data-v="{{ b.summary.category or 'Z' }}">{% if b.summary.category %}<span class="cat cat-{{ b.summary.category }}">{{ b.summary.category }}</span>{% else %}<span class="cat cat-none">&lt;IV</span>{% endif %}</td>
      <td class="num" data-v="{{ b.summary.meets_target_pct if b.summary.meets_target_pct is not none else -1 }}">{{ b.summary.meets_target_pct | pct(0) }}</td>
      <td class="num {{ b.summary.ieq_score | level }}" data-v="{{ b.summary.ieq_score if b.summary.ieq_score is not none else -1 }}">{{ b.summary.ieq_score | num }}</td>
      {% for p in ["temperature", "co2", "humidity"] %}
      {% set v = b.summary.compliance.get(p) %}
      <td class="num {{ v | level }}" data-v="{{ v if v is not none else -1 }}">{{ v | pct }}</td>
      {% endfor %}
      {% set h = b.summary.exceedance_hours.get("co2>1000") %}
      <td class="num" data-v="{{ h if h is not none else -1 }}">{{ h | num(0) }}</td>
      <td>{{ category_bar(b.summary.category_counts, width=200, height=14) }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>

{% set worst = report.worst_rooms %}
{% macro heatmap(key, columns, col_label, kind) %}
<table class="heat">
  <thead><tr><th></th>{% for c in columns %}<th>{{ col_label(c) }}</th>{% endfor %}</tr></thead>
  <tbody>
  {% for b in report.buildings %}{% set prof = b.summary.profiles.get(key) or {} %}{% if prof %}
    <tr class="group"><th class="rowh">{{ b.building_name }} – {{ _("Building average") }}</th>
    {% for c in columns %}{% set v = prof.get(c) %}<td class="{{ heat_class(v, kind) }}">{{ heat_text(v, kind) }}</td>{% endfor %}</tr>
  {% endif %}{% endfor %}
  {% for r in worst %}{% set prof = r.profiles.get(key) or {} %}{% if prof %}
    <tr><th class="rowh">{{ r.building_name }} · {{ r.room_name }}</th>
    {% for c in columns %}{% set v = prof.get(c) %}<td class="{{ heat_class(v, kind) }}">{{ heat_text(v, kind) }}</td>{% endfor %}</tr>
  {% endif %}{% endfor %}
  </tbody>
</table>
{% endmacro %}
{% set hour_cols = profile_columns(report, "co2>1000_pct_by_hour") %}
{% set month_cols = profile_columns(report, "co2>1000_pct_by_month") %}
{% set temp_cols = profile_columns(report, "temperature>26_h_by_month") %}
{% if hour_cols or month_cols %}
<h2 class="page-break">{{ _("Time patterns") }}</h2>
{% if hour_cols %}
<div class="card">
  <h3>{{ _("CO₂ above 1000 ppm by time of day") }}</h3>
  <p class="muted small">{{ _("Share of occupied time above 1000 ppm, for the rooms needing attention and each building.") }}</p>
  <div class="scroll">{{ heatmap("co2>1000_pct_by_hour", hour_cols, hour_label, "pct") }}</div>
  <div class="heat-legend"><span style="--c:var(--lvl-1-bg)">&lt; 10 %</span><span style="--c:var(--lvl-2-bg)">10–25 %</span><span style="--c:var(--lvl-3-bg)">25–50 %</span><span style="--c:var(--lvl-4-bg)">≥ 50 %</span></div>
</div>
{% endif %}
{% if month_cols %}
<div class="card" style="margin-top:12px">
  <h3>{{ _("CO₂ above 1000 ppm by month") }}</h3>
  <div class="scroll">{{ heatmap("co2>1000_pct_by_month", month_cols, month_label, "pct") }}</div>
</div>
{% endif %}
{% if temp_cols %}
<div class="card" style="margin-top:12px">
  <h3>{{ _("Hours above 26 °C by month") }}</h3>
  <p class="muted small">{{ _("Occupied hours above 26 °C, for the rooms needing attention and each building (building rows: average per room).") }}</p>
  <div class="scroll">{{ heatmap("temperature>26_h_by_month", temp_cols, month_label, "hours") }}</div>
  <div class="heat-legend"><span style="--c:var(--lvl-1-bg)">0</span><span style="--c:var(--lvl-2-bg)">&lt; 10</span><span style="--c:var(--lvl-3-bg)">10–25</span><span style="--c:var(--lvl-4-bg)">≥ 25 {{ unit_h }}</span></div>
</div>
{% endif %}
{% endif %}

{% if worst %}
<h2 class="page-break">{{ _("Rooms needing attention") }}</h2>
<p class="muted">{{ _("The {n} room(s) furthest from the Category {cat} target, worst first.", n=(worst | length), cat=cfg.target_category) }}</p>
{% for r in worst %}
<article class="card room-card">
  <header>
    <div>
      <h3>{{ r.room_name }}</h3>
      <div class="muted small">{{ [r.building_name, r.floor_name, r.room_type and _(r.room_type)] | select | join(" · ") }}{% if r.area_m2 %} · {{ r.area_m2 | num(0, "m²") }}{% endif %}</div>
    </div>
    <div>
      {% if r.achieved_category %}<span class="cat cat-{{ r.achieved_category }}">{{ r.achieved_category }}</span>{% else %}<span class="cat cat-none">–</span>{% endif %}
      <span class="pill {{ r.ieq_score | level }}">{{ _("Score") }} {{ r.ieq_score | num }}</span>
      {% if r.br18_pass is not none %}<span class="pill" title="{{ r.br18_failed | map('translate') | join('; ') }}">BR18 {{ _("pass") if r.br18_pass else _("fail") }}</span>{% endif %}
    </div>
  </header>
  {% if r.tail %}<div class="room-tail">TAIL {{ tail_badge(r.tail.overall, _("Overall")) }}
    {% for key, name in tail_domains %}{{ tail_badge((r.tail.domains or {}).get(key), name) }}{% endfor %}</div>{% endif %}
  {% if r.issues %}<ul class="issues">{% for i in r.issues %}<li>{{ i }}</li>{% endfor %}</ul>{% endif %}
  {% if r.parameters %}
  <div class="scroll">
  <table class="small">
    <thead><tr><th>{{ _("Parameter") }}</th><th class="num">{{ _("Within Cat {cat}", cat=cfg.target_category) }}</th><th class="num">{{ _("Mean") }}</th><th class="num">{{ _("Min") }}</th><th class="num">{{ _("Max") }}</th></tr></thead>
    <tbody>
    {% for p, ps in r.parameters.items() %}
      <tr><td>{{ param_label(p) }}</td><td class="num {{ ps.compliance_pct | level }}">{{ ps.compliance_pct | pct }}</td>
      <td class="num">{{ ps.mean | num(1, ps.unit or "") }}</td><td class="num">{{ ps.minimum | num(1) }}</td><td class="num">{{ ps.maximum | num(1) }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
  {% if r.seasons | length > 1 %}
  <p class="small muted">{{ _("By season") }}:
    {% for se in r.seasons %}{{ _("{season} {cat} ({pct} within target)", season=(_(se.season) | capitalize), cat=(se.achieved_category or "–"), pct=(se.compliance_pct | pct(0))) }}{% if se.adaptive %} ({{ _("adaptive") }}){% endif %}{% if not loop.last %} · {% endif %}{% endfor %}
  </p>
  {% endif %}
  {% if r.exceedance_hours %}
  <p class="small"><strong>{{ _("Hours above limits (occupied)") }}:</strong>
    {% for key, hours in r.exceedance_hours.items() %}{% set p, lim = key.split(">") %}{{ param_label(p) }} &gt; {{ lim }}: {{ hours | num(0, unit_h) }}{% if not loop.last %} · {% endif %}{% endfor %}
  </p>
  {% endif %}
  {% if r.period_breakdown %}
  <p class="small"><strong>{{ _("By time of day") }}:</strong>
    {% for name, st in r.period_breakdown.items() %}{{ _("{period}: CO₂ mean {mean}, > 1000 ppm {pct} of the time", period=(_(name) | capitalize) ~ period_span(name), mean=(st.get("co2_mean") | num(0, "ppm")), pct=(st.get("co2>1000_pct") | pct(0))) }}{% if not loop.last %} · {% endif %}{% endfor %}
  </p>
  {% endif %}
  {% if r.ventilation %}<p class="small"><strong>{{ _("After-hours air change (CO₂ decay)") }}:</strong> {{ r.ventilation.ach | num(2) }} {{ _("per hour") }} ({{ _("median of {n} decays, interquartile range {lo}–{hi}; background {bg} ppm", n=r.ventilation.decays, lo=(r.ventilation.ach_iqr[0] | num(2)), hi=(r.ventilation.ach_iqr[1] | num(2)), bg=(r.ventilation.background_co2 | num(0))) }}). <span class="muted">{{ _("Measured while the room is empty, when ventilation may be reduced or off: it does not show the ventilation during use.") }}{% if r.ventilation.resolvable_max_ach %} {{ _("At this sampling interval rates above about {x} per hour cannot be resolved.", x=(r.ventilation.resolvable_max_ach | num(1))) }}{% endif %}</span></p>{% endif %}
  {% if r.recommendations %}
  <details>
    <summary>{{ _("{n} recommendation(s)", n=(r.recommendations | length)) }}</summary>
    {% for rec in r.recommendations %}
    <div class="rec">
      <strong>{{ rec.title }}</strong> <span class="small prio-{{ rec.priority }}">{{ _(rec.priority | capitalize) }}</span>
      <div class="small">{{ rec.description }}</div>
      {% if rec.expected_benefit %}<div class="small muted">{{ _("Benefit") }}: {{ rec.expected_benefit }}</div>{% endif %}
    </div>
    {% endfor %}
  </details>
  {% endif %}
  <div class="small muted">
    {{ _("Data: {n} samples, {start} → {end}, {pct} complete", n=(r.data_quality.get("samples", 0) | num(0)), start=(r.data_quality.get("start") | date), end=(r.data_quality.get("end") | date), pct=(r.data_quality.get("completeness_pct") | pct(0))) }}{% if r.data_quality.get("gaps") %}, {{ _("{n} gap(s)", n=r.data_quality.get("gaps")) }}{% endif %}.
    {% if r.warnings %}<br>{{ _("Notes") }}: {{ r.warnings | join(" ") }}{% endif %}
  </div>
</article>
{% endfor %}
{% endif %}

<h2 class="page-break">{{ _("All rooms") }}</h2>
<details {% if report.rooms | length <= 60 %}open{% endif %}>
<summary>{{ _("Show all {n} rooms", n=(report.rooms | length)) }}</summary>
<input class="filter" type="search" placeholder="{{ _('Filter rooms, buildings, categories…') }}" aria-label="{{ _('Filter rooms') }}" data-filter="rooms-table">
<div class="table-wrap">
<table class="sortable" id="rooms-table">
  <thead><tr>
    <th data-sort="text">{{ _("Building") }}</th><th data-sort="text">{{ _("Floor") }}</th><th data-sort="text">{{ _("Room") }}</th>
    <th data-sort="text">{{ _("Category") }}</th><th data-sort="num" class="num">{{ _("Score") }}</th>
    <th data-sort="num" class="num">{{ _("Temp.") }}</th><th data-sort="num" class="num">CO₂</th><th data-sort="num" class="num">{{ _("RH") }}</th>
    <th data-sort="num" class="num">CO₂&gt;1000 {{ unit_h }}</th><th data-sort="num" class="num">T&gt;26 {{ unit_h }}</th>
    <th data-sort="text">TAIL</th><th data-sort="num" class="num">{{ _("Data") }}</th>
  </tr></thead>
  <tbody>
  {% for r in report.rooms %}
    <tr>
      <td>{{ r.building_name or "–" }}</td><td>{{ r.floor_name or "–" }}</td>
      <td>{{ r.room_name }}{% if r.status != "ok" %} <span class="pill">{{ _("no data") if r.status == "no_data" else _("error") }}</span>{% endif %}</td>
      <td data-v="{{ r.achieved_category or 'Z' }}">{% if r.achieved_category %}<span class="cat cat-{{ r.achieved_category }}">{{ r.achieved_category }}</span>{% else %}–{% endif %}</td>
      <td class="num {{ r.ieq_score | level }}" data-v="{{ r.ieq_score if r.ieq_score is not none else -1 }}">{{ r.ieq_score | num }}</td>
      {% for p in ["temperature", "co2", "humidity"] %}
      {% set v = r.compliance.get(p) %}
      <td class="num {{ v | level }}" data-v="{{ v if v is not none else -1 }}">{{ v | pct }}</td>
      {% endfor %}
      {% for key in ["co2>1000", "temperature>26"] %}
      {% set h = r.exceedance_hours.get(key) %}
      <td class="num" data-v="{{ h if h is not none else -1 }}">{{ h | num(0) }}</td>
      {% endfor %}
      <td>{{ r.tail_rating or "–" }}</td>
      {% set c = r.data_quality.get("completeness_pct") %}
      <td class="num" data-v="{{ c if c is not none else -1 }}">{{ c | pct(0) }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
</details>

{% set problem_rooms = report.rooms | selectattr("status", "ne", "ok") | list %}
{% if problem_rooms %}
<h2>{{ _("Data coverage") }}</h2>
<div class="card">
  <p>{{ _("{n} room(s) were not assessed:", n=(problem_rooms | length)) }}</p>
  <ul class="small">
    {% for r in problem_rooms[:200] %}<li>{{ r.building_name or "–" }} / {{ r.room_name }}: {{ r.message }}</li>{% endfor %}
    {% if problem_rooms | length > 200 %}<li>{{ _("… and {n} more (see JSON/CSV export).", n=(problem_rooms | length - 200)) }}</li>{% endif %}
  </ul>
</div>
{% endif %}

<h2>{{ _("Method") }}</h2>
<div class="card small">
  <ul class="findings">
    <li>{{ _("<strong>Standard.</strong> Rooms are assessed with EN 16798-1 (plus TAIL and BR18 where applicable). Each parameter reaches the best category whose limits it meets in at least 95 % of its measured occupied hours, and the room takes its worst parameter; Category IV is anything outside Category III. CO₂ limits are 550/800/1350 ppm above an assumed outdoor level of 400 ppm (950/1200/1750 ppm). Relative humidity is reported but counts towards the category only in rooms with humidity control, because EN 16798-1 gives humidity criteria for dimensioning (de)humidification.") | safe }}</li>
    <li>{% if cfg.seasons | length > 1 %}{{ _("<strong>Seasons.</strong> Data is split into the country's heating and cooling months; each part is assessed with its own criteria, and a room's category is its worst seasonal category.") | safe }}{% else %}{{ _("<strong>Seasons.</strong> All data is assessed with {season} criteria.", season=_(cfg.seasons[0])) | safe }}{% endif %}</li>
    {% if "summer" in cfg.seasons or "all_year" in cfg.seasons %}{% set adaptive_used = report.rooms | map(attribute="seasons") | sum(start=[]) | selectattr("adaptive") | list %}<li>{% if adaptive_used %}{{ _("<strong>Outside the heating season</strong> rooms in buildings without mechanical cooling are assessed with the EN 16798-1 adaptive model: limits follow the running mean of the daily outdoor temperature θrm (Category II from 0.33·θrm + 14.8 °C to 0.33·θrm + 21.8 °C; upper limits valid for θrm 10–30 °C, lower for 15–30 °C, held at the end of the range outside it). In the heating season the fixed ranges apply.") | safe }}{% else %}{{ _("<strong>Outside the heating season</strong> the fixed cooling-season ranges are used (Category II 23–26 °C). They assume a cooled building; for buildings without mechanical cooling (configuration mechanical_cooling: false) EN 16798-1's adaptive model applies, which needs outdoor temperature.") | safe }}{% endif %}</li>{% endif %}
    <li>{% if cfg.occupied_only %}{{ _("<strong>Assessed hours.</strong> Standards are applied to occupied hours only ({hours}); the air-change estimate uses all hours. Hours above limits are weighted by each sample's duration.", hours=(occ | join("; ") | e)) | safe }}{% else %}{{ _("<strong>Assessed hours.</strong> All hours are assessed.") | safe }}{% endif %}</li>
    <li>{{ _("<strong>Compliance %.</strong> Share of samples within Category {cat} limits, per parameter. Parameters below {pct} are listed as issues.", cat=cfg.target_category, pct=(cfg.issue_threshold_pct | pct(0))) | safe }}</li>
    <li>{{ _("<strong>IEQ score.</strong> Weighted mean of parameter compliance ({weights}; weights renormalised over available parameters).", weights=score_weights) | safe }}</li>
    <li>{{ _("<strong>Building and portfolio category.</strong> An hvx summary, not part of EN 16798-1: the best category that at least {pct} of rated rooms reach. Building and portfolio averages are area-weighted when every room has a floor area.", pct=((cfg.group_category_threshold * 100) | pct(0))) | safe }}</li>
    {% if report.rooms | selectattr("br18_pass", "ne", none) | list %}<li>{{ _("<strong>BR18.</strong> Checked once over all assessed hours of the period. The 100 h above 26 °C and 25 h above 27 °C are the BR18 guidance values on thermal indoor climate, which normally satisfy the requirement for offices and are documented by calculation; for schools the building owner sets the hours. § 447 (1000 ppm CO₂ in teaching rooms) is a design requirement. Applied to measured data, both are indicators, not a compliance verdict.") | safe }}</li>{% endif %}
    {% if cfg.include_simulations %}<li>{{ _("<strong>Recommendations.</strong> Rule-based on measured occupied time: CO₂ above 1000 ppm, temperatures outside the target category's range per season, hours above 26 °C, humidity below 25 % or above 60 %. A rule fires above 5 % of the occupied time; priorities (high from 25 %, medium from 10 %) are hvx's own judgement. Expected effects are estimates with stated assumptions: the outdoor-air factor assumes steady state; hours above 26 °C avoided by shading come from a regression on solar irradiance and outdoor temperature and assume shading removes 70 % of the measured solar effect.") | safe }}</li>{% endif %}
    {% for note in cfg.notes %}<li>{{ note }}</li>{% endfor %}
    <li>{{ _("<strong>Identifiers.</strong> Brick classes and IFC GlobalIds for every room are in the JSON and CSV exports.") | safe }}</li>
  </ul>
</div>

{% if brand %}
<section class="imprint">
  {{ _("Report prepared by") }} <strong>{{ brand.legal_name or brand.name }}</strong>{% if brand.cvr %} · {{ _("CVR no. {cvr}", cvr=brand.cvr) }}{% endif %}
  {% for item in [brand.address, brand.email, brand.phone, brand.website] if item %} · {{ item }}{% endfor %}
</section>
{% endif %}

<footer>
  {{ report.schema_version }} · {{ report.rooms | length }} {{ _("rooms") }} · {{ _("built in {s} s", s=(report.duration_s | num(1))) }}
</footer>
</main>
<script>
(function () {
  document.querySelectorAll("table.sortable").forEach(function (table) {
    table.querySelectorAll("th[data-sort]").forEach(function (th, col) {
      th.addEventListener("click", function () {
        var body = table.tBodies[0], rows = Array.prototype.slice.call(body.rows);
        var numeric = th.dataset.sort === "num", dir = th.dataset.dir === "asc" ? -1 : 1;
        th.dataset.dir = dir === 1 ? "asc" : "desc";
        var idx = Array.prototype.indexOf.call(th.parentNode.children, th);
        rows.sort(function (a, b) {
          var x = a.cells[idx], y = b.cells[idx];
          var vx = x.dataset.v !== undefined ? x.dataset.v : x.textContent.trim();
          var vy = y.dataset.v !== undefined ? y.dataset.v : y.textContent.trim();
          return numeric ? dir * (parseFloat(vx) - parseFloat(vy)) : dir * vx.localeCompare(vy);
        });
        rows.forEach(function (r) { body.appendChild(r); });
      });
    });
  });
  document.querySelectorAll("input[data-filter]").forEach(function (input) {
    var table = document.getElementById(input.dataset.filter);
    input.addEventListener("input", function () {
      var q = input.value.toLowerCase();
      Array.prototype.forEach.call(table.tBodies[0].rows, function (row) {
        row.style.display = row.textContent.toLowerCase().indexOf(q) === -1 ? "none" : "";
      });
    });
  });
})();
</script>
</body>
</html>
